# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ─── Database ─────────────────────────────────────────────────────────────────
# Dev: Docker Postgres (see docker-compose.yml)
# Prod: replace with your hosted connection string
DATABASE_URL=postgresql://folioforge:folioforge@localhost:5432/folioforge_db

# ─── Auth ──────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

SESSION_SECRET=change-me-to-a-long-random-secret-minimum-32-chars

# ─── Redis (BullMQ) ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
FRONTEND_URL=http://localhost:5173

# OpenAI AI Resume Parser
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

