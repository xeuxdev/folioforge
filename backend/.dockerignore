.agents
skills-lock.json

# Test files
test
coverage
**/*.spec.ts

# Logs
*.log

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore

# Editor artifacts
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# TypeScript source — production image only needs dist/
src
drizzle.config.ts
